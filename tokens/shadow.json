{
  "panel": { "$type": "shadow", "$value": "0 4px 24px rgba(0, 0, 0, 0.5)" },
  "float": { "$type": "shadow", "$value": "0 8px 32px rgba(0, 0, 0, 0.65)" },
  "dock": { "$type": "shadow", "$value": "0 -4px 40px rgba(0, 0, 0, 0.75)" },
  "glow-primary": { "$type": "shadow", "$value": "0 0 12px rgba(255, 152, 48, 0.25)" },
  "glow-danger": { "$type": "shadow", "$value": "0 0 12px rgba(255, 48, 48, 0.25)" },
  "glow-info": { "$type": "shadow", "$value": "0 0 12px rgba(32, 240, 255, 0.25)" },
  "bevel": { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.35), inset 0 -2px 0 rgba(0, 0, 0, 0.3)" },

  "halo-alpha": { "$type": "number", "$value": "0.55" },
  "halo-blur": { "$type": "dimension", "$value": "6px" },
